<?xml version="1.0" encoding="utf-8"?>
<!-- Restores from nuget.org alone, whatever feeds the machine or user NuGet config adds, so a package of the same name
     on another feed can't win. Every package ID maps to nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
