<!-- Central Package Management: every PackageReference in the repository takes its version from here.
     Each version was the latest stable one on nuget.org on 2026-11-04. -->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.2.0" />
    <PackageVersion Include="Avalonia.HarfBuzz" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Skia" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Win32" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.342" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!-- No Microsoft.Testing.Platform entry: TUnit brings its own compatible version, and a pin
       here would override it through transitive pinning. -->
  <ItemGroup Label="Testing">
    <!-- FakeTimeProvider, for the log's timestamps (opinions/testing.md). -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
  </ItemGroup>

</Project>
