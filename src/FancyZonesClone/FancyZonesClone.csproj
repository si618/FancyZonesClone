<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The tray app hosts Win32 hooks, so it only runs on Windows. -->
    <TargetFramework>net11.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- MinVer takes the version from the v* tag, so there's no <Version> to edit. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <PropertyGroup Label="Native AOT">
    <!-- Publish one self-contained native executable, so there's no .NET runtime to install and it starts
         quickly at sign-in. -->
    <PublishAot>true</PublishAot>
    <!-- Without it, PublishAot defaults the publish RID to the build host's, which adds linux-x64 on the Ubuntu
         CodeQL runner, and the locked restore fails with NU1004 because packages.lock.json has only win-x64. -->
    <PublishRuntimeIdentifier>win-x64</PublishRuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- The hooks do little work per event, so smaller code beats faster code here. -->
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup Label="Native AOT">
    <!-- ILCompiler doesn't pass /Brepro, so link.exe stamps the build time into the PE header and debug directory and
         a random GUID into the PDB reference. /Brepro derives them from a hash of the output, so a rebuild of a tag
         matches its release byte for byte. reproducible.yml checks it. -->
    <LinkerArg Include="/Brepro" />
  </ItemGroup>

  <!-- Program.cs renders in software, so ANGLE is never loaded. Avalonia.Win32 still depends on
       Avalonia.Angle.Windows.Natives, so drop its DLL from the publish output. -->
  <Target Name="RemoveAngleFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'av_libglesv2.dll'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="Avalonia" />
    <!-- Avalonia.Win32, Avalonia.Skia, and Avalonia.HarfBuzz instead of Avalonia.Desktop, which also pulls in the
         X11 and macOS backends. -->
    <PackageReference Include="Avalonia.Win32" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FancyZonesClone.Core/FancyZonesClone.Core.csproj" />
    <ProjectReference Include="../FancyZonesClone.Windows/FancyZonesClone.Windows.csproj" />
  </ItemGroup>

</Project>
