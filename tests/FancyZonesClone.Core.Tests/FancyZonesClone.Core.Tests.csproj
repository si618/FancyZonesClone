<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPublishable>false</IsPublishable>
    <!-- The app ships only as Native AOT, so CI also publishes this project natively and runs the executable. Set
         here, not on the command line, so the trim and AOT analysers check the tests in every build and
         packages.lock.json holds the ILCompiler for the locked restore. CI passes IsPublishable for that lane. -->
    <PublishAot>true</PublishAot>
    <!-- Without it, PublishAot defaults the publish RID to the build host's, and the locked restore fails with
         NU1004 because packages.lock.json has only win-x64. -->
    <PublishRuntimeIdentifier>win-x64</PublishRuntimeIdentifier>
    <!-- TUnit test projects build to an executable on Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <!-- house:simon-mckenna begin -->
    <!-- **House:** CA1707 (no underscores in member names) contradicts the test-naming convention
         UnitOfWork_Scenario_ExpectedBehaviour. The convention wins in test projects. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- house:simon-mckenna end -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="TUnit" />
    <ProjectReference Include="../../src/FancyZonesClone.Core/FancyZonesClone.Core.csproj" />
  </ItemGroup>

</Project>
